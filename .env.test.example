# Copy to .env.test before running `npm test`.
# Points at the throwaway Postgres in docker-compose.test.yml (port 5433).
DATABASE_URL="postgresql://meydan_test:meydan_test@localhost:5433/meydan_test"
DIRECT_URL="postgresql://meydan_test:meydan_test@localhost:5433/meydan_test"

# Any non-empty value works; the suite only round-trips tokens against itself.
AUTH_SECRET="test-secret-not-used-outside-tests"

# Audience for Google ID-token verification tests (never contacts Google —
# the verifier is stubbed).
GOOGLE_CLIENT_ID="test-google-client-id"
