    <string name="auth_phone_title">Вход по номеру</string>
    <string name="auth_phone_sub">Без SMS — просто номер и пароль.</string>
    <string name="auth_phone_label">Номер телефона</string>
    <string name="auth_password_label">Пароль</string>
    <string name="auth_login">Войти</string>
    <string name="auth_logout">Выйти</string>
    <string name="auth_terms">Продолжая, вы принимаете условия использования и политику конфиденциальности</string>
    <string name="auth_phone_placeholder" translatable="false">65 12 34 56</string>

