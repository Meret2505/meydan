<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Permits cleartext HTTP to the local dev server reached via
  `adb reverse tcp:3000 tcp:3000` (localhost) or the emulator host alias
  (10.0.2.2). Release builds have no such exemption and speak HTTPS only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
