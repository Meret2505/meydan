<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug overlay: attaches the cleartext-to-localhost network security config so
  the app can talk to the Next.js dev server. Merged into the main manifest for
  debug builds only, so release builds never permit cleartext.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
