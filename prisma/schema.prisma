generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum GameStatus {
  OPEN
  FULL
  COMPLETED
  CANCELLED
}

enum GameType {
  OPEN
  TEAM_MATCH
}

enum NotificationType {
  GAME_INVITE
  SPOT_OPENED
  GAME_REMINDER
  RESULT_NEEDED
  PLAYER_JOINED
  GAME_CANCELLED
  TEAM_INVITE
  FIELD_APPROVED
  FIELD_REJECTED
}

enum FieldSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String     @id @default(cuid())
  email          String?    @unique
  name           String
  phone          String?    @unique
  password       String?
  avatar         String?
  position       Position?
  skillLevel     SkillLevel @default(BEGINNER)
  district       String?
  age            Int?
  isOpenToInvite Boolean    @default(true)
  fcmToken       String?
  locale         String     @default("ru")
  // DB-backed admin flag — set manually (see migration comment). Kept off the
  // access token (15-minute TTL) so a revoked admin loses power immediately
  // rather than at token expiry; admin-only routes pay one extra query.
  isAdmin        Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  organizedGames           Game[]            @relation("Organizer")
  gameParticipants         GameParticipant[]
  teamMemberships          TeamMember[]
  notifications            Notification[]
  sentInvites              GameInvite[]      @relation("InviteSender")
  receivedInvites          GameInvite[]      @relation("InviteReceiver")
  favoriteFields           FieldFavorite[]
  refreshTokens            RefreshToken[]
  fieldSubmissions         FieldSubmission[] @relation("FieldSubmissionAuthor")
  reviewedFieldSubmissions FieldSubmission[] @relation("FieldSubmissionReviewer")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Field {
  id         String   @id @default(cuid())
  externalId Int?     @unique
  name       String
  nameTm     String?
  nameRu     String?
  address    String
  addressTm  String?
  addressRu  String?
  bodyTm     String?
  bodyRu     String?
  district   String
  surface    String
  capacity   Int
  phone      String?
  image      String?
  photos     String[]
  latitude   Float?
  longitude  Float?
  hours      Json?
  contacts   Json?
  attributes Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  games       Game[]
  favoritedBy FieldFavorite[]
  submissions FieldSubmission[]

  @@map("fields")
}

model FieldFavorite {
  userId    String
  fieldId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([userId, fieldId])
  @@map("field_favorites")
}

// A player-submitted pitch, held for admin review before it becomes a real
// `Field` row. Deliberately a separate table rather than a `status` column on
// `Field`: every existing field read path (list, detail, game-creation picker,
// favorites) filters only on `isActive`, which defaults to `true` — a pending
// row inserted straight into `fields` would be publicly visible immediately.
// Approval is an explicit `Field.create`, so `fields` never contains
// unmoderated content and an approved submission becomes admin-owned (the
// author has no further write path to it).
model FieldSubmission {
  id              String                @id @default(cuid())
  submittedById   String
  name            String
  address         String
  district        String
  surface         String
  capacity        Int
  phone           String?
  description     String?
  // Storage keys, same form as Field.photos. Capped at 3 by the service.
  photos          String[]
  status          FieldSubmissionStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  // Set on approve — the Field row this submission became.
  fieldId         String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  submittedBy User   @relation("FieldSubmissionAuthor", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy  User?  @relation("FieldSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  field       Field? @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([submittedById])
  @@map("field_submissions")
}

model Game {
  id              String     @id @default(cuid())
  type            GameType   @default(OPEN)
  status          GameStatus @default(OPEN)
  scheduledAt     DateTime
  fieldId         String?
  fieldName       String?
  totalSpots      Int
  pricePerPlayer  Int?
  neededPositions Position[]
  notes           String?
  scoreHome       Int?
  scoreAway       Int?
  organizerId     String
  teamId          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  field        Field?            @relation(fields: [fieldId], references: [id])
  organizer    User              @relation("Organizer", fields: [organizerId], references: [id])
  team         Team?             @relation(fields: [teamId], references: [id])
  participants GameParticipant[]
  invites      GameInvite[]

  @@index([scheduledAt])
  // The feed's `where status` + `orderBy scheduledAt` in one index; it also
  // serves a status-only lookup, so the old single-column @@index([status])
  // was redundant and is gone.
  @@index([status, scheduledAt])
  @@index([organizerId])
  @@index([fieldId])
  @@index([teamId])
  @@map("games")
}

model GameParticipant {
  id       String   @id @default(cuid())
  gameId   String
  userId   String
  attended Boolean?
  joinedAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId, attended])
  @@map("game_participants")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  color     String?
  district  String?
  createdAt DateTime @default(now())

  members         TeamMember[]
  games           Game[]
  homeMatches     TournamentMatch[] @relation("HomeTeam")
  awayMatches     TournamentMatch[] @relation("AwayTeam")
  tournamentTeams TournamentTeam[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  isCaptain Boolean  @default(false)
  joinedAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Tournament {
  id          String    @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime?
  description String?
  creatorId   String?
  cancelled   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  matches TournamentMatch[]
  teams   TournamentTeam[]

  @@map("tournaments")
}

model TournamentTeam {
  id           String   @id @default(cuid())
  tournamentId String
  teamId       String
  joinedAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@map("tournament_teams")
}

model TournamentMatch {
  id           String    @id @default(cuid())
  tournamentId String
  homeTeamId   String
  awayTeamId   String
  scheduledAt  DateTime?
  scoreHome    Int?
  scoreAway    Int?
  round        String?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam   Team       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team       @relation("AwayTeam", fields: [awayTeamId], references: [id])

  @@index([tournamentId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@map("tournament_matches")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// Fixed-window rate-limit counters. One row per (bucket + subject) key, e.g.
// "login:ip:1.2.3.4". Postgres-backed so the limit is shared across all
// serverless instances (Vercel) and the single VPS container alike — no
// external store required. Rows self-expire via `expiresAt` (see rateLimit()).
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

/// One row per (caller, Idempotency-Key) on a create endpoint.
///
/// A phone on a Turkmen mobile link loses a response far more often than it
/// loses a request: the game is created, the reply never arrives, and the
/// client — or the person tapping again — asks a second time. Without a key to
/// recognise the repeat by, that is a duplicate game, and the duplicate is
/// indistinguishable from a real one.
///
/// The row is claimed *before* the work runs, so the unique constraint is what
/// serialises two requests racing with the same key rather than an application
/// check that both would pass. `response` stays null until the work succeeds:
/// a repeat arriving in between gets "request_in_progress", and a failed
/// attempt deletes its own claim so a corrected retry is not locked out by it.
///
/// `endpoint` is not part of the key — a client generates one UUID per submit,
/// so the same key on a different endpoint means a client bug, and saying so is
/// more useful than replaying a game's body at a team create.
model IdempotencyKey {
  id        String   @id @default(cuid())
  userId    String
  key       String
  endpoint  String
  response  Json?
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Refresh tokens for the native mobile clients. The web app keeps using
/// NextAuth's cookie session and never touches this table.
///
/// Only the SHA-256 hash of the token is stored, so a database leak yields
/// nothing usable. Tokens rotate on every refresh: the old row is marked
/// revoked and a new one issued in the same family. Presenting an already
/// rotated token means it leaked, so the whole family is revoked at once.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  /// Groups every token descended from one login, so a detected reuse can
  /// revoke the entire chain rather than just the replayed token.
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model GameInvite {
  id         String   @id @default(cuid())
  gameId     String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  game     Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sender   User @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("InviteReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([gameId, receiverId])
  @@map("game_invites")
}
